    "ax.set_ylim(bottom=0)\n",
    "\n",
    "# Custom legends\n",
    "celltype_patches = [mpatches.Patch(color=color, label=ct) for ct, color in celltype_colors.items()]\n",
    "dataset_patches = [mpatches.Patch(color=color, label=ds.capitalize()) for ds, color in dataset_colors.items()]\n",
    "\n",
    "# Add both legends\n",
    "celltype_legend = ax.legend(handles=celltype_patches, title='Cell Type', bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "ax.add_artist(celltype_legend)  # so it stays when adding second legend\n",
    "\n",
    "ax.legend(handles=dataset_patches, title='Publication', bbox_to_anchor=(1.05, 0.6), loc='upper left')\n",
    "\n",

    "    if celltype_idx == 0:\n",
    "        new_x = x - shift_amount / 2\n",
    "    else:\n",
    "        new_x = x + shift_amount / 2\n",
    "    \n",
    "    box.set_x(new_x)\n",
    "    # Optionally shrink width a bit so boxes don't overlap\n",
    "    box.set_width(width_box - shift_amount)\n",
    "\n",
    "\n",
    "# Manual dot plotting with jitter and alignment (same as before)\n",
    "width = 0.8\n",
    "n_hue = len(selected_celltypes)\n",

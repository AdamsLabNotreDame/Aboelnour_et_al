    "# Axis labels and layout\n",
    "ax.set_xlabel('Condition')\n",
    "ax.set_ylabel('Proportion of Cells')\n",
    "ax.set_title('')\n",
    "ax.set_xticks(ticks=range(len(lesion_order)))\n",

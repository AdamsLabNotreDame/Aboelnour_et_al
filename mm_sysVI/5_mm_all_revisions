    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import matplotlib.patches as mpatches\n",
    "import numpy as np\n",
    "import pandas as pd  # make sure pandas is imported\n",
    "\n",
    "# Add ~50% opacity by appending '80' (hex for 128/255 alpha) to the color codes:\n",
    "celltype_colors_transparent = {\n",
    "    'MOLs': '#cc006680',      # 50% opacity\n",
    "    'Microglia': '#2d2dd980',\n",
    "}\n",
    "\n",
    "dataset_colors = {\n",
    "    'adams': '#d25982',\n",
    "    'pandey': '#003a7d',\n",
    "    'shen': '#e4d00a',\n",
    "}\n",
    "\n",
    "selected_celltypes = list(celltype_colors.keys())  # MOLs first now\n",
    "\n",
    "# Filter and process\n",
    "adata_filtered = adata_all[adata_all.obs['cluster_annotation'].isin(selected_celltypes)]\n",
    "\n",
    "cell_counts = (\n",
    "    adata_filtered.obs\n",
    "    .groupby(['sample_id_anon', 'lesion_status', 'cluster_annotation'])\n",
    "    .size()\n",
    "    .reset_index(name='cell_count')\n",
    ")\n",
    "total_counts = (\n",
    "    cell_counts\n",
    "    .groupby(['sample_id_anon', 'lesion_status'])['cell_count']\n",
    "    .sum()\n",
    "    .reset_index(name='total_count')\n",
    ")\n",
    "cell_counts = cell_counts.merge(total_counts, on=['sample_id_anon', 'lesion_status'])\n",
    "cell_counts['proportion'] = cell_counts['cell_count'] / cell_counts['total_count']\n",
    "cell_counts['lesion_status'] = pd.Categorical(cell_counts['lesion_status'], categories=lesion_order, ordered=True)\n",
    "cell_counts['dataset'] = cell_counts['sample_id_anon'].str.extract(r'^(adams|pandey|shen)', expand=False)\n",
    "\n",
    "# Plot setup\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "\n",
    "# Use transparent colors for box fills\n",
    "sns.boxplot(\n",
    "    data=cell_counts,\n",
    "    x='lesion_status',\n",
    "    y='proportion',\n",
    "    hue='cluster_annotation',\n",
    "    palette=celltype_colors_transparent,  # use transparent colors here\n",
    "    hue_order=selected_celltypes,\n",
    "    ax=ax,\n",
    "    width=0.6,\n",
    "    showcaps=True,\n",
    "    showfliers=False,\n",
    "    whiskerprops={'linewidth':1},\n",
    "    medianprops={'color': 'black', 'linewidth': 1.5},\n",
    "    dodge=True\n",
    ")\n",
    "\n",
    "# Get the boxes (artists)\n",
    "boxes = [patch for patch in ax.artists if isinstance(patch, plt.Rectangle)]\n",
    "\n",
    "# Number of lesion_status categories and cell types\n",
    "n_lesions = len(lesion_order)\n",
    "n_celltypes = len(selected_celltypes)\n",
    "\n",
    "# Amount to shift boxes apart (increase spacing)\n",
    "shift_amount = 0.05  # tweak this for more/less spacing\n",
    "\n",
    "for i, box in enumerate(boxes):\n",
    "    # The box artist order corresponds to lesion_status * cell_type\n",
    "    # Calculate lesion and celltype indices\n",
    "    lesion_idx = i // n_celltypes\n",
    "    celltype_idx = i % n_celltypes\n",
    "    \n",
    "    # Compute original box position\n",
    "    x = box.get_x()\n",
    "    width_box = box.get_width()\n",
    "    \n",
